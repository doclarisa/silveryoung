# Copy this file to .env.local and fill in the values.
# .env.local is never committed to GitHub.

# Your site's public address (no trailing slash).
# Locally: http://localhost:3000   On Vercel: https://silveryoungmodels.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable key" (starts with sb_publishable_). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (starts with sb_secret_). SECRET, server-only.
# Used only to fully delete a member's account. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
