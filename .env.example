# Copy this file to .env.local and fill in the values.
# .env.local is never committed to GitHub.

# Your site's public address (no trailing slash).
# Locally: http://localhost:3000   On Vercel: https://silveryoungmodels.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (filled in during Step 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-only. Used only to fully delete a member's account.
# Never prefix with NEXT_PUBLIC_ and never paste it anywhere else.
SUPABASE_SERVICE_ROLE_KEY=
